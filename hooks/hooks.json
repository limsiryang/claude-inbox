{
  "description": "Feeds the user's new inbox replies into the agent's context",
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/inbox/inbox.py\" hook || python \"${CLAUDE_PLUGIN_ROOT}/inbox/inbox.py\" hook", "timeout": 10 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/inbox/inbox.py\" hook || python \"${CLAUDE_PLUGIN_ROOT}/inbox/inbox.py\" hook", "timeout": 10 } ] }
    ]
  }
}
